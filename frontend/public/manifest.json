{
  "manifest_version": 3,
  "name": "Upbit Live Ticker",
  "version": "1.0",
  "description": "실시간 업비트 시세",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "commands": {
    "toggle-upbit-popup": {
      "suggested_key": {
        "default": "Ctrl+U"
      },
      "description": "업비트 팝업 열기/닫기"
    }
  }
}