{
  "manifest_version": 3,
  "name": "Choco",
  "version": "1.0.0",
  "description": "업비트 실시간 시세 뷰어",

  "action": {
    "default_popup": "index.html",
    "default_title": "Upbit Viewer"
  },

  "icons": {
    "16": "16.png",
    "48": "48.png",
    "128": "128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "toggle_popup": {
      "suggested_key": {
        "default": "Ctrl+X"
      },
      "description": "Popup 열기/닫기"
    }
  },

  "host_permissions": [
    "https://newchromeproject.onrender.com/*"
  ]
}