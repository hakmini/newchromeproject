{
  "manifest_version": 3,
  "name": "Choco - 코인의 실시간 시세를 빠르게 확인하세요!",
  "version": "1.0.1",
  "description": "초단위 코인 시세 뷰어 초코(Choco)입니다!",

  "action": {
    "default_popup": "index.html",
    "default_title": "Upbit Viewer"
  },

  "icons": {
    "16": "16.png",
    "48": "48.png",
    "128": "128.png"
  },


  "commands": {
    "toggle_popup": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Popup 열기/닫기"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": ["windows"],

  "host_permissions": [
    "http://3.34.28.81:8080/*"
  ]
}